// Paste into https://dbdiagram.io
Table roles { role_id tinyint [pk, increment] role_name varchar [unique, not null] }
Table users {
  user_id int [pk, increment]
  name varchar [not null]
  email varchar [unique, not null]
  password_hash char(60) [not null]
  role_id tinyint [not null, ref: > roles.role_id]
  referred_by int [ref: > users.user_id]
  created_at timestamp
}
Table admin_profiles { user_id int [pk, ref: - users.user_id] department varchar }
Table genres { genre_id int [pk] name varchar [unique] }
Table movies { movie_id int [pk] title varchar [not null] release_year smallint poster_path varchar tmdb_rating decimal }
Table movie_genres { movie_id int [ref: > movies.movie_id] genre_id int [ref: > genres.genre_id] indexes { (movie_id, genre_id) [pk] } }
Table watchlist { user_id int [ref: > users.user_id] movie_id int [ref: > movies.movie_id] added_at timestamp indexes { (user_id, movie_id) [pk] } }
Table reviews {
  review_id int [pk, increment]
  user_id int [not null, ref: > users.user_id]
  movie_id int [not null, ref: > movies.movie_id]
  rating tinyint [not null, note: 'CHECK 1..10']
  body varchar
  version int [default: 1]
  indexes { (user_id, movie_id) [unique] }
}
Table plans { plan_id tinyint [pk, increment] name varchar [unique] price decimal duration_days int }
Table wallets { user_id int [pk, ref: - users.user_id] balance decimal [note: 'CHECK >= 0'] }
Table subscriptions {
  subscription_id int [pk, increment]
  user_id int [ref: > users.user_id]
  plan_id tinyint [ref: > plans.plan_id]
  start_date date
  end_date date
  status enum
}
Table transactions {
  txn_id bigint [pk, increment]
  user_id int [ref: > users.user_id]
  type enum
  amount decimal
  balance_after decimal
  subscription_id int [ref: > subscriptions.subscription_id]
  created_at timestamp
}
